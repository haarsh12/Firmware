# Copy this file to .env. The service-account JSON is deliberately not copied
# into this project. Keep it outside version control and point to it here.
GOOGLE_APPLICATION_CREDENTIALS=../home_automation/project-d8fe05cb-90bb-4815-aca-c79b84dcbad5.json

# Leave blank to use project_id from the service-account file.
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# Server and browser app settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Audio sent by esp32_inmp441_voice. It must match the firmware.
VOICE_SAMPLE_RATE=16000
VOICE_SAMPLE_WIDTH=2
VOICE_MAX_AUDIO_SECONDS=60
SPEECH_LANGUAGE=hi-IN
SPEECH_ALTERNATIVE_LANGUAGES=en-IN
SPEECH_MODEL=latest_long
VOICE_DEBUG_EVERY_FRAMES=20

# Change to true after wiring the optional MAX98357A I2S speaker.
ENABLE_CLOUD_TTS=false
TTS_LANGUAGE=hi-IN
TTS_VOICE_NAME=
TTS_SAMPLE_RATE=16000

# Optional fallback for an older relay sketch that exposes /light/on etc.
# The new relay firmware uses /ws/relay, so leave blank unless needed.
ESP32_HTTP_BASE_URL=

MAX_ASSISTANT_WORDS=45
ASSISTANT_MAX_OUTPUT_TOKENS=512

# Local persistent college/project knowledge base, refreshed by the script.
KNOWLEDGE_BASE_ENABLED=true
KNOWLEDGE_BASE_DIRECTORY=data/chroma
KNOWLEDGE_BASE_COLLECTION=svpcet_assistant
KNOWLEDGE_BASE_EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_BASE_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_BASE_RESULTS=4
KNOWLEDGE_BASE_MAX_CONTEXT_CHARS=5000

# Opens YouTube only in the backend laptop's default browser after an explicit command.
DESKTOP_MEDIA_ENABLED=true
YOUTUBE_SEARCH_TIMEOUT_SECONDS=8

# Optional Xiaozhi Cloud MCP bridge. Keep secrets only in .env, never Git.
XIAOZHI_MCP_ENABLED=true
XIAOZHI_MCP_SHARED_SECRET=replace-with-a-private-random-value
XIAOZHI_MCP_ALLOW_UNAUTHENTICATED=false
# Copy the portal-generated wss://api.xiaozhi.me/mcp/?token=... value here.
# Do not publish or commit it: it is a bearer credential.
XIAOZHI_CLOUD_MCP_URL=
XIAOZHI_MCP_RECONNECT_MAX_SECONDS=30

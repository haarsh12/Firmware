# Copy this file to .env. The service-account JSON is deliberately not copied
# into this project. Keep it outside version control and point to it here.
GOOGLE_APPLICATION_CREDENTIALS=../home_automation/project-d8fe05cb-90bb-4815-aca-c79b84dcbad5.json

# Leave blank to use project_id from the service-account file.
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# Server and browser app settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Audio sent by esp32_inmp441_voice. It must match the firmware.
VOICE_SAMPLE_RATE=16000
VOICE_SAMPLE_WIDTH=2
VOICE_MAX_AUDIO_SECONDS=25
SPEECH_LANGUAGE=hi-IN
SPEECH_ALTERNATIVE_LANGUAGES=en-IN
SPEECH_MODEL=latest_long
VOICE_DEBUG_EVERY_FRAMES=20

# Keep false for a microphone-only ESP32. Change to true only after wiring the
# optional MAX98357A I2S speaker in the firmware.
ENABLE_CLOUD_TTS=false
TTS_LANGUAGE=hi-IN
TTS_VOICE_NAME=
TTS_SAMPLE_RATE=16000

# Optional fallback for an older relay sketch that exposes /light/on etc.
# The new relay firmware uses /ws/relay, so leave blank unless needed.
ESP32_HTTP_BASE_URL=

MAX_ASSISTANT_WORDS=45
ASSISTANT_MAX_OUTPUT_TOKENS=256
